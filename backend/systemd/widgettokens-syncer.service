[Unit]
Description=WidgetTokens Client Syncer One-Shot
After=network.target

[Service]
Type=oneshot
WorkingDirectory=%h/Documentos/Proyectos/widgettokens
# Automatically detects local computer hostname via socket.gethostname()
ExecStart=/usr/bin/python3 -m backend.syncer --once
Environment=PYTHONUNBUFFERED=1
Environment=WIDGETTOKENS_SERVER_URL=http://127.0.0.1:8765
